{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "declaration": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "outDir": "dist/cli",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/main/cli/**/*.ts",
    "src/main/cli/**/*.tsx",
    "src/main/services/**/*",
    "src/main/utils/**/*",
    "src/main/ipc/channels.ts",
    "src/main/ipc/validators.ts",
    "src/shared/**/*"
  ],
  "exclude": [
    "src/main/index.ts",
    "src/main/preload.ts",
    "src/main/ipc/handlers.ts",
    "src/main/services/UISettingsStore.ts",
    "src/main/services/devtools/**/*",
    "src/renderer/**/*",
    "src/web/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**"
  ]
}
