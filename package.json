{
  "name": "claude-code-orchestra",
  "version": "0.1.0-beta.3",
  "description": "Desktop app for managing Claude Code CLI instances",
  "author": "Endika Vicioso Marquinez",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endikavi/claude-code-orchestra.git"
  },
  "bugs": {
    "url": "https://github.com/endikavi/claude-code-orchestra/issues"
  },
  "homepage": "https://github.com/endikavi/claude-code-orchestra#readme",
  "keywords": [
    "claude",
    "ai",
    "electron",
    "orchestra",
    "terminal",
    "cli",
    "claude-code",
    "headless",
    "server"
  ],
  "main": "dist/main/index.js",
  "bin": {
    "claude-orchestra": "./dist/cli/main/cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:web && electron-builder",
    "build:vite": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "build:cli": "tsc -p tsconfig.cli.json",
    "start:server": "node dist/cli/main/cli/index.js",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build:vite && npm run build:web && electron-builder",
    "electron:build:linux": "npm run build:vite && npm run build:web && electron-builder --linux",
    "electron:build:win": "npm run build:vite && npm run build:web && electron-builder --win",
    "electron:build:mac": "npm run build:vite && npm run build:web && electron-builder --mac",
    "rebuild": "electron-rebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives",
    "lint:strict": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "postinstall": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime electron --target 34.5.8 && cd ../.. && npx @electron/rebuild -f -w node-pty"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "electron-store": "^10.0.0",
    "express": "^5.2.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.3.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.claude.orchestra",
    "productName": "Orchestra",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "maintainer": "Orchestra Team"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  }
}
